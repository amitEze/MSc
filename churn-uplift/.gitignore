# Ignore Python cache and init files
__pycache__/
**/__pycache__/
__init__.py
**/__init__.py

# Ignore Python bytecode
*.pyc
*.pyo
*.pyd

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore virtual environments
venv/
.venv/
env/
.env/

# Ignore logs and temp files
*.log
*.tmp
*.swp


# Ignore OS files
.DS_Store
Thumbs.db
